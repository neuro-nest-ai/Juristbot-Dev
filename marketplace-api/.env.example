NODE_ENV=development
PORT=3001

# Comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=change_me
JWT_EXPIRES_IN=1h

# DB_CLIENT: 'sqlite' (zero-setup local dev) or 'mysql' (production)
DB_CLIENT=mysql
DB_SQLITE_FILE=marketplace.dev.sqlite

# MySQL (used when DB_CLIENT=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=marketplace_db
DB_CONNECTION_LIMIT=10
